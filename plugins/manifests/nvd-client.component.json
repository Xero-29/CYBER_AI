{
  "manifest_version": 1,
  "id": "nvd-cve-client",
  "name": "NVD CVE Client",
  "version": "0.1.0",
  "kind": "knowledge_provider",
  "entrypoint": "nvd_client",
  "capabilities": ["cve_lookup", "vulnerability_metadata"],
